<Window x:Class="Earcue.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Earcue Overlay"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1" Direction="315" Color="#000000" Opacity="0.8"/>
    </Window.Resources>
    
    <Grid Margin="16">
        <!-- Main Card Container -->
        <Border x:Name="CardBorder"
                Background="#D012161F"
                CornerRadius="12"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Padding="16,14"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45"/>
            </Border.Effect>
            
            <StackPanel Orientation="Vertical">
                <!-- Header with App Mark and Status -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#00E676" Margin="0,0,6,0"/>
                        <TextBlock Text="附耳 Earcue" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="TxtLatency"
                               Text="1.2s"
                               HorizontalAlignment="Right"
                               Foreground="#66FFFFFF"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Heard Question -->
                <TextBlock x:Name="TxtQuestion"
                           Text="[对方] 灰度策略怎么保证回滚？"
                           Foreground="#A0B0C0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           MaxHeight="48"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8"
                           Effect="{StaticResource TextShadow}"/>

                <!-- Suggested Quick Answer -->
                <TextBlock x:Name="TxtAnswer"
                           Text="按 5% 分批，每批观察 30 分钟，异常率超 1% 立即回滚上一版本"
                           Foreground="#00F0FF"
                           FontSize="15"
                           FontWeight="Bold"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           MaxHeight="72"
                           TextTrimming="CharacterEllipsis"
                           Effect="{StaticResource TextShadow}"/>
            </StackPanel>
        </Border>

        <!-- Edit mode chrome -->
        <Rectangle x:Name="EditBorder"
                   Stroke="#38BDF8"
                   StrokeThickness="1.5"
                   StrokeDashArray="4 3"
                   RadiusX="12"
                   RadiusY="12"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <Thumb x:Name="ResizeGrip"
               Width="18"
               Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,4,4"
               Cursor="SizeNWSE"
               Visibility="Collapsed"
               DragDelta="ResizeGrip_DragDelta"
               DragCompleted="ResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#38BDF8" CornerRadius="4">
                        <Path Data="M 4 14 L 14 4 M 9 14 L 14 9"
                              Stroke="#0F141C"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
