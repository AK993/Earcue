<Window x:Class="Earcue.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Earcue Overlay"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1" Direction="315" Color="#000000" Opacity="0.8"/>
    </Window.Resources>
    
    <Grid Margin="16">
        <!-- Independent background and text layers; window opacity is reserved for fade animations. -->
        <Border x:Name="BackgroundLayer"
                Background="#173428"
                CornerRadius="16"
                BorderBrush="#405D7E63"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="#10271A" Opacity="0.28"/>
            </Border.Effect>
        </Border>
        <Border x:Name="CardBorder"
                Background="Transparent"
                CornerRadius="16"
                Padding="20,17"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel x:Name="TextLayer" Orientation="Vertical">
                <!-- Header with App Mark and Status -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="5" Height="5" CornerRadius="2.5" Background="#95DCAE" Margin="0,0,7,0"/>
                        <TextBlock Text="附耳 · 回答建议" Foreground="#A3C6AE" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="TxtLatency"
                               Text="1.2s"
                               HorizontalAlignment="Right"
                               Foreground="#789287"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Heard Question -->
                <TextBlock x:Name="TxtQuestion"
                           Text="[对方] 灰度策略怎么保证回滚？"
                           Foreground="#AAC7B3"
                           FontSize="13"
                           TextWrapping="Wrap"
                           MaxHeight="48"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8"
                           Effect="{StaticResource TextShadow}"/>

                <!-- Suggested Quick Answer -->
                <TextBlock x:Name="TxtAnswer"
                           Text="按 5% 分批，每批观察 30 分钟，异常率超 1% 立即回滚上一版本"
                           Foreground="#00F0FF"
                           FontSize="15"
                           FontWeight="Medium"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           MaxHeight="72"
                           TextTrimming="CharacterEllipsis"
                           Effect="{StaticResource TextShadow}"/>
            </StackPanel>
        </Border>

        <!-- Edit mode chrome -->
        <Rectangle x:Name="EditBorder"
                   Stroke="#95DCAE"
                   StrokeThickness="1.5"
                   StrokeDashArray="4 3"
                   RadiusX="12"
                   RadiusY="12"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <Thumb x:Name="ResizeGrip"
               Width="18"
               Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,4,4"
               Cursor="SizeNWSE"
               Visibility="Collapsed"
               DragDelta="ResizeGrip_DragDelta"
               DragCompleted="ResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#95DCAE" CornerRadius="5">
                        <Path Data="M 4 14 L 14 4 M 9 14 L 14 9"
                              Stroke="#0F141C"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
