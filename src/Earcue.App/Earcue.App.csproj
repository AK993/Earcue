<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Earcue.Core\Earcue.Core.csproj" />
    <ProjectReference Include="..\Earcue.Audio\Earcue.Audio.csproj" />
    <ProjectReference Include="..\Earcue.Speech\Earcue.Speech.csproj" />
    <ProjectReference Include="..\Earcue.Brain\Earcue.Brain.csproj" />
    <ProjectReference Include="..\Earcue.Overlay\Earcue.Overlay.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows-only 单进程应用：只带 win-x64 原生库，避免把 Android/Linux/macOS 的运行时打进输出 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

</Project>
