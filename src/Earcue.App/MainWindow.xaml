<Window x:Class="Earcue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="附耳 Earcue · 会议实时问答助手 控制台 (v0.1)"
        Height="680" Width="960"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0F141C"
        Foreground="#E0E6ED">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161F2E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="12" Height="12" CornerRadius="6" Background="#10B981" Margin="0,0,10,0"/>
                <TextBlock Text="附耳 Earcue" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="· 会议实时提词器" FontSize="14" Foreground="#94A3B8" Margin="8,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnTestOverlay" Content="💡 预览" Margin="0,0,10,0" ToolTip="预览置顶字幕卡" Click="BtnTestOverlay_Click"/>
                <Button x:Name="BtnEditOverlay" Content="🖱 调整" Margin="0,0,10,0" ToolTip="打开后可以鼠标拖动/缩放字幕卡" Click="BtnEditOverlay_Click"/>
                <Button x:Name="BtnModelSettings" Content="⚙ 设置" Margin="0,0,10,0" Click="BtnModelSettings_Click"/>
                <Button x:Name="BtnProfile" Content="👤 面试资料" Margin="0,0,10,0" Click="BtnProfile_Click"/>
                <Button x:Name="BtnToggleCapture" Content="▶ 启动采集与本地识别" Click="BtnToggleCapture_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status & Settings Strip -->
        <Border Grid.Row="1" Background="#161F2E" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#223046" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Col 1: Audio Loopback Status -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="音频采集 (WASAPI)" FontSize="12" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtAudioStatus" Text="状态: 未运行 (点击上方启动)" FontSize="13" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtSampleCount" Text="累计帧数: 0 帧 | 漂移: 0ms" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtAsrModel" Text="ASR: 未加载" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Col 2: Overlay Capture Status -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="置顶字幕层 (Win32 Overlay)" FontSize="12" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtOverlayStatus" Text="状态: 屏幕共享捕获排除生效中" FontSize="13" Foreground="#34D399"/>
                    <TextBlock Text="WDA_EXCLUDEFROMCAPTURE = 0x11" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Col 3: LLM Settings -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="回答模型 (LLM API)" FontSize="12" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtLlmStatus" Text="DeepSeek · deepseek-chat" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtLlmKeyStatus" Text="API Key: 未配置，点击【设置】" FontSize="11" Foreground="#FBBF24" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Left Transcript / Right Trigger & Cards -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Transcript Feed -->
            <Border Grid.Column="0" Background="#141B26" CornerRadius="8" Padding="14" Margin="0,0,10,0" BorderBrush="#223046" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="实时转录流水线 (带 [对方]/[我] 角色标注)" FontSize="13" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtLiveAsr" Text="" FontSize="12" Foreground="#38BDF8"
                                   FontFamily="Consolas, Microsoft YaHei"
                                   TextTrimming="CharacterEllipsis" MinHeight="16" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ScrollerTranscript" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtTranscript"
                                 Background="Transparent"
                                 Foreground="#CBD5E1"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="13"
                                 FontFamily="Consolas, Microsoft YaHei"
                                 Text="[系统] 附耳流水线就绪。点击右上角【启动采集与本地识别】开始监听会议声音。&#x0a;[系统] 首次使用需先安装本地 ASR 模型，缺少模型时启动会提示下载命令。&#x0a;"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Question Triggers and Answer Cards -->
            <Border Grid.Column="1" Background="#141B26" CornerRadius="8" Padding="14" BorderBrush="#223046" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="触发问题与 40 字速答记录" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" x:Name="ScrollerCards" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelCards" Orientation="Vertical">
                            <!-- Sample Card item -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="[对方] 那你们这个灰度策略怎么保证回滚？" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="按 5% 分批，每批观察 30 分钟，异常率超 1% 立即回滚上一版本" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Manual Input / Fast Test Bar -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtManualQuestion" Grid.Column="0" Text="你们这个灰度策略怎么保证回滚？" Margin="0,0,8,0"/>
                        <Button x:Name="BtnManualAsk" Grid.Column="1" Content="模拟提问" Click="BtnManualAsk_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Status Bar -->
        <StatusBar Grid.Row="3" Background="Transparent" Foreground="#64748B" FontSize="11" Margin="0,10,0,0">
            <StatusBarItem Content="单进程 Earcue.exe · .NET 8 WPF"/>
            <Separator Background="#223046"/>
            <StatusBarItem Content="隐私保证：音频原始数据不出本机、不落盘"/>
            <Separator Background="#223046"/>
            <StatusBarItem Content="默认热键：Ctrl+Alt+H (卡片显隐) | Ctrl+Alt+X (快速收起)"/>
        </StatusBar>
    </Grid>
</Window>
