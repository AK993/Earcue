<UserControl x:Class="Earcue.App.AnswerCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#F2F8F4" BorderBrush="#DEEBE2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,4,12">
        <StackPanel>
            <DockPanel Margin="0,0,0,5">
                <Button x:Name="BtnStop" Content="停止生成" Click="BtnStop_Click" DockPanel.Dock="Right" Visibility="Collapsed" MinHeight="24" Padding="8,2" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="TxtQuestionLabel" Text="问题" Foreground="#718179" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox x:Name="TxtQuestion" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" MaxHeight="120" VerticalScrollBarVisibility="Auto" Foreground="#365D49" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" ToolTip="可以修改问题，再点击重新回答。" />
            <Expander x:Name="OriginalTextExpander" Header="查看识别原文" Visibility="Collapsed" Foreground="#718179" FontSize="10.5" Margin="0,0,0,10">
                <TextBox x:Name="TxtOriginalQuestion" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Padding="0,6,0,0" MinHeight="0" MaxHeight="120" VerticalScrollBarVisibility="Auto" FontSize="11" Foreground="#718179" />
            </Expander>
            <TextBox x:Name="TxtAnswer" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                     Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                     Foreground="#203A31" FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI"
                     TextBlock.LineHeight="24" />
            <TextBlock x:Name="TxtStatus" Foreground="#718179" FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,4" />
            <WrapPanel>
                <Button x:Name="BtnRetry" Content="重新回答" Click="BtnRetry_Click" MinHeight="26" Padding="8,3" FontSize="11" Margin="0,4,6,0" />
                <Button x:Name="BtnCopy" Content="复制" Click="BtnCopy_Click" MinHeight="26" Padding="8,3" FontSize="11" Margin="0,4,0,0" IsEnabled="False" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
