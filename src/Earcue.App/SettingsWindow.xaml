<Window x:Class="Earcue.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 模型 / 字幕卡 / 自动应答"
        Height="980" Width="820"
        MinHeight="700" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0F141C"
        Foreground="#E0E6ED"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="DimBrush" Color="#64748B"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#141B26"/>
            <Setter Property="BorderBrush" Value="#223046"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M 0 0 L 4.5 4.5 L 9 0"
                                                  Stroke="#94A3B8"
                                                  StrokeThickness="1.6"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,36,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#161F2E"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#243044"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#101722" BorderBrush="#475569" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 0 3.5 L 3 6.5 L 8 1"
                                      Stroke="#38BDF8" StrokeThickness="1.8"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="BorderBrush" Value="#223046"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#E0E6ED"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1B2636"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,1">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3B4A60" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="10"/>
                                <Setter Property="MinHeight" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#223046" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track"
                                   Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#38BDF8" Stroke="#0F141C" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>

        <!-- Header -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="设置" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                       Text="API Key 经 Windows DPAPI 加密后仅存本机 config.json，不写日志，也只发送到你填写的接口；换电脑或账户后需重填。字幕卡外观与自动应答保存后立即生效。"/>
        </StackPanel>

        <!-- 1. Provider -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="1 · 选择服务商" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbProvider" Grid.Column="0"
                              TextSearch.TextPath="DisplayName"
                              SelectionChanged="CmbProvider_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="BtnOpenKeyPage" Grid.Column="1"
                            Style="{StaticResource LinkButton}"
                            Content="去申请 API Key ↗"
                            Margin="6,0,0,0"
                            Click="BtnOpenKeyPage_Click"/>
                </Grid>
                <TextBlock x:Name="TxtProviderNote" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Connection -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="2 · 连接信息" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="BASE URL（OpenAI 兼容接口地址）" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtBaseUrl" Height="34" TextChanged="TxtBaseUrl_TextChanged"/>

                <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="PwdApiKey" Height="34"/>
                        <TextBox x:Name="TxtApiKeyVisible" Height="34" Visibility="Collapsed"/>
                    </Grid>
                    <CheckBox x:Name="ChkShowKey" Grid.Column="1" Content="显示明文" Margin="12,0,0,0"
                              VerticalAlignment="Center" Checked="ChkShowKey_Changed" Unchecked="ChkShowKey_Changed"/>
                    <Button x:Name="BtnClearKey" Grid.Column="2" Content="清空"
                            Style="{StaticResource LinkButton}" Margin="4,0,0,0"
                            Click="BtnClearKey_Click"/>
                </Grid>
                <TextBlock x:Name="TxtKeyHint" Style="{StaticResource HintText}" Margin="0,7,0,0"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnFetchModels" Grid.Column="0"
                            Style="{StaticResource PrimaryButton}"
                            Content="🔍 获取可用模型"
                            Click="BtnFetchModels_Click"/>
                    <Button x:Name="BtnTestModel" Grid.Column="1"
                            Content="⚡ 测试调用"
                            Margin="10,0,0,0"
                            Click="BtnTestModel_Click"/>
                    <TextBlock x:Name="TxtStatus" Grid.Column="2"
                               Style="{StaticResource HintText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="先填写 Key，再获取该 Key 实际可调用的模型列表。"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Model -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="3 · 选择模型" Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="模型 ID（可直接输入任意模型名）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtModel" Height="34" FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtModelCount" Grid.Column="1"
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Bottom"
                               Margin="12,0,0,7"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,12,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="可用模型（点击选中，也可直接输入）" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0"/>
                    <TextBlock Grid.Column="1" Text="筛选" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="#64748B" FontSize="11" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtModelFilter" Grid.Column="2" Width="230" Height="28"
                             Padding="8,4" FontFamily="Microsoft YaHei UI"
                             TextChanged="TxtModelFilter_TextChanged"
                             ToolTip="按模型 ID 或提供方过滤，例如 qwen、deepseek"/>
                </Grid>

                <ListBox x:Name="LstModels" Grid.Row="3"
                         Style="{StaticResource DarkListBox}"
                         SelectionChanged="LstModels_SelectionChanged"
                         Height="184">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="12.5"
                                               Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                               Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#164E63" CornerRadius="4" Padding="6,2"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="预设" FontSize="10" Foreground="#67E8F9"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 4. Overlay & Auto Answer -->
        <Border Style="{StaticResource CardBorder}" Margin="0">
            <StackPanel>
                <TextBlock Text="4 · 字幕卡与自动应答" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="字幕卡默认显示在左下角。字体、字号、透明度和位置保存后立即生效。"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="位置" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbOverlayPosition" SelectionChanged="OverlayCombo_Changed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbOverlayFont" SelectionChanged="OverlayCombo_Changed"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="答案颜色" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ColorSwatch}" Background="#00F0FF" Tag="#00F0FF"
                                ToolTip="青色" Click="AnswerColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatch}" Background="#F8FAFC" Tag="#F8FAFC"
                                ToolTip="白色" Click="AnswerColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatch}" Background="#FACC15" Tag="#FACC15"
                                ToolTip="黄色" Click="AnswerColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatch}" Background="#34D399" Tag="#34D399"
                                ToolTip="绿色" Click="AnswerColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatch}" Background="#FB7185" Tag="#FB7185"
                                ToolTip="粉色" Click="AnswerColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatch}" Background="#A78BFA" Tag="#A78BFA"
                                ToolTip="紫色" Click="AnswerColorSwatch_Click"/>
                        <TextBox x:Name="TxtAnswerColor" Width="88" Height="28" Padding="6,4"
                                 FontFamily="Consolas" Text="#00F0FF"
                                 TextChanged="AnswerColor_TextChanged"
                                 ToolTip="支持 #RRGGBB 或颜色名，例如 #00F0FF"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <TextBlock Text="答案字号" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="−" Style="{StaticResource StepButton}" Tag="AnswerFontDown" Click="OverlayStep_Click"/>
                                <TextBlock x:Name="TxtAnswerFontSizeValue" Text="15" Foreground="#38BDF8" FontSize="11"
                                           MinWidth="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="+" Style="{StaticResource StepButton}" Tag="AnswerFontUp" Click="OverlayStep_Click"/>
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="SldAnswerFontSize" Minimum="12" Maximum="40" Value="15"
                                IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" LargeChange="4"
                                ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock Text="问题字号" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="−" Style="{StaticResource StepButton}" Tag="QuestionFontDown" Click="OverlayStep_Click"/>
                                <TextBlock x:Name="TxtQuestionFontSizeValue" Text="13" Foreground="#38BDF8" FontSize="11"
                                           MinWidth="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="+" Style="{StaticResource StepButton}" Tag="QuestionFontUp" Click="OverlayStep_Click"/>
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="SldQuestionFontSize" Minimum="10" Maximum="30" Value="13"
                                IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" LargeChange="4"
                                ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <TextBlock Text="透明度" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="−" Style="{StaticResource StepButton}" Tag="OpacityDown" Click="OverlayStep_Click"/>
                            <TextBlock x:Name="TxtOpacityValue" Text="92%" Foreground="#38BDF8" FontSize="11"
                                       MinWidth="34" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Style="{StaticResource StepButton}" Tag="OpacityUp" Click="OverlayStep_Click"/>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="SldOverlayOpacity" Minimum="5" Maximum="100" Value="92"
                            IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" LargeChange="4"
                            ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0"/>
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <TextBlock Text="水平边距" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="−" Style="{StaticResource StepButton}" Tag="MarginXDown" Click="OverlayStep_Click"/>
                                <TextBlock x:Name="TxtMarginXValue" Text="24" Foreground="#38BDF8" FontSize="11"
                                           MinWidth="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="+" Style="{StaticResource StepButton}" Tag="MarginXUp" Click="OverlayStep_Click"/>
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="SldMarginX" Minimum="0" Maximum="200" Value="24"
                                IsSnapToTickEnabled="True" TickFrequency="2" IsMoveToPointEnabled="True" LargeChange="4"
                                ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock Text="垂直边距" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="−" Style="{StaticResource StepButton}" Tag="MarginYDown" Click="OverlayStep_Click"/>
                                <TextBlock x:Name="TxtMarginYValue" Text="24" Foreground="#38BDF8" FontSize="11"
                                           MinWidth="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="+" Style="{StaticResource StepButton}" Tag="MarginYUp" Click="OverlayStep_Click"/>
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="SldMarginY" Minimum="0" Maximum="200" Value="24"
                                IsSnapToTickEnabled="True" TickFrequency="2" IsMoveToPointEnabled="True" LargeChange="4"
                                ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="#101722" BorderBrush="#223046" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,14,0,0">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoAnswer"
                                  Content="静音后自动应答（不再只判断疑问句）"
                                  Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="静音等待" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="−" Style="{StaticResource StepButton}" Tag="AutoSilenceDown" Click="OverlayStep_Click"/>
                                <TextBlock x:Name="TxtAutoSilenceValue" Text="2.0 秒" Foreground="#38BDF8" FontSize="11"
                                           MinWidth="46" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="+" Style="{StaticResource StepButton}" Tag="AutoSilenceUp" Click="OverlayStep_Click"/>
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="SldAutoSilence" Minimum="1" Maximum="10" Value="2"
                                IsSnapToTickEnabled="True" TickFrequency="0.5" IsMoveToPointEnabled="True" LargeChange="0.5"
                                ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="连续这段时间没有新的识别内容，就把最近全部对话发给大模型生成一条接话提示。"/>
                    </StackPanel>
                </Border>

                <Border Background="#101722" BorderBrush="#223046" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoHide"
                                  Content="一段时间后自动隐藏字幕卡"
                                  Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="隐藏等待" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbAutoHideSeconds" Grid.Column="1" Width="120"
                                      SelectionChanged="OverlayCombo_Changed">
                                <ComboBoxItem Content="10 秒" Tag="10"/>
                                <ComboBoxItem Content="20 秒" Tag="20"/>
                                <ComboBoxItem Content="30 秒" Tag="30"/>
                                <ComboBoxItem Content="60 秒" Tag="60"/>
                                <ComboBoxItem Content="120 秒" Tag="120"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="默认关闭。关闭后卡片会一直保留，直到下一次回答替换它。"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PreviewCard" Background="#D012161F" BorderBrush="#30FFFFFF"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="预览（实际位置按上方选择）" Foreground="#64748B" FontSize="10" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtPreviewQuestion" Text="[对方] 让我自我介绍一下"
                                   Foreground="#A0B0C0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtPreviewAnswer" Text="好的，我先简单介绍一下自己负责的工作。"
                                   Foreground="#38BDF8" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 5. Local ASR Model Selection -->
        <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="5 · 语音识别模型 (ASR)" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource HintText}"
                           Text="负责将会议中对方的声音实时转为文字。完全在本地离线运行，音频不上传任何服务器。"/>

                <Grid Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="选择本地识别模型" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbAsrModel" SelectionChanged="CmbAsrModel_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="0,2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TxtAsrModelStatus" Style="{StaticResource HintText}" Margin="0,8,0,0" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource HintText}" VerticalAlignment="Center"
                       Text="保存后立即生效，无需重启。"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}"
                        Content="保存并应用" IsDefault="True" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
