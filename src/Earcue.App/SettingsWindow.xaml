<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Earcue.App.SettingsWindow" Title="设置 · 附耳 Earcue" Width="920" Height="800" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico" Background="#F3F7F5" Foreground="#203A31" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="个性化你的附耳" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="配置模型、语音识别与字幕，让每次对话更顺手。" Style="{StaticResource HintText}" Margin="0,7,0,0" />
        </StackPanel>
        <TabControl Grid.Row="1" x:Name="SettingsTabs" Style="{StaticResource SettingsTabsStyle}">
            <TabItem Header="回答模型">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="服务商" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbProvider" Grid.Column="0" TextSearch.TextPath="DisplayName" SelectionChanged="CmbProvider_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#203A31" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="BtnOpenKeyPage" Grid.Column="1" Style="{StaticResource LinkButton}" Content="去申请 API Key ↗" Margin="6,0,0,0" Click="BtnOpenKeyPage_Click" />
                                </Grid>
                                <TextBlock x:Name="TxtProviderNote" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="连接信息" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="BASE URL（OpenAI 兼容接口地址）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtBaseUrl" Height="40" TextChanged="TxtBaseUrl_TextChanged" />
                                <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <PasswordBox x:Name="PwdApiKey" Height="40" />
                                        <TextBox x:Name="TxtApiKeyVisible" Height="40" Visibility="Collapsed" />
                                    </Grid>
                                    <CheckBox x:Name="ChkShowKey" Grid.Column="1" Content="显示" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ChkShowKey_Changed" Unchecked="ChkShowKey_Changed" />
                                    <Button x:Name="BtnClearKey" Grid.Column="2" Content="清空" Style="{StaticResource LinkButton}" Margin="4,0,0,0" Click="BtnClearKey_Click" />
                                </Grid>
                                <TextBlock x:Name="TxtKeyHint" Style="{StaticResource HintText}" Margin="0,7,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnFetchModels" Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="获取模型列表" Click="BtnFetchModels_Click" />
                                    <Button x:Name="BtnTestModel" Grid.Column="1" Content="测试连接" Margin="10,0,0,0" Click="BtnTestModel_Click" />
                                    <TextBlock x:Name="TxtStatus" Grid.Column="2" Style="{StaticResource HintText}" Margin="12,0,0,0" VerticalAlignment="Center" Text="填写连接信息，测试服务是否可用。" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="回答模型" Style="{StaticResource SectionTitle}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="模型 ID（可直接输入任意模型名）" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtModel" Height="40" FontFamily="Consolas" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtModelCount" Grid.Column="1" Style="{StaticResource HintText}" VerticalAlignment="Bottom" Margin="12,0,0,7" />
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,12,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="可用模型（点击选中，也可直接输入）" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                                    <TextBlock Grid.Column="1" Text="筛选" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7A8B82" FontSize="11" Margin="0,0,8,0" />
                                    <TextBox x:Name="TxtModelFilter" Grid.Column="2" Width="230" Height="28" Padding="8,4" FontFamily="Microsoft YaHei UI" TextChanged="TxtModelFilter_TextChanged" ToolTip="按模型 ID 或提供方过滤，例如 qwen、deepseek" />
                                </Grid>
                                <ListBox x:Name="LstModels" Grid.Row="3" Style="{StaticResource DarkListBox}" SelectionChanged="LstModels_SelectionChanged" Height="184">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="12.5" Foreground="#203A31" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#7A8B82" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#E0F1E8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="预设" FontSize="10" Foreground="#157D64" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="语音识别">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Background="#E6F2EB" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                            <TextBlock Text="模型在本机运行。轻量版可在这里按需下载，安装后保存并开始聆听；切换模型或专业词后需重新启动采集。" Foreground="#286A50" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="本地语音识别" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource HintText}" Text="负责将会议中对方的声音实时转为文字。完全在本地离线运行，音频不上传任何服务器。" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="选择本地识别模型" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CmbAsrModel" SelectionChanged="CmbAsrModel_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Vertical" Margin="0,2">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#203A31" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="660" FontSize="11" Foreground="#718179" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="TxtAsrModelStatus" Style="{StaticResource HintText}" Margin="0,8,0,0" Foreground="#157D64" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnDownloadAsr" Content="下载所选模型" Click="BtnDownloadAsr_Click" />
                                    <Button x:Name="BtnCancelAsrDownload" Content="取消下载" Click="BtnCancelAsrDownload_Click" Margin="10,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                                <ProgressBar x:Name="AsrDownloadProgress" Height="6" Margin="0,12,0,0" Maximum="100" Visibility="Collapsed" />
                                <TextBlock x:Name="TxtAsrDownloadProgress" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="TxtModelDirectory" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="专业词与人名" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                    <Button x:Name="BtnExtractResumeWords" Content="根据简历自动填充" Click="BtnExtractResumeWords_Click" />
                                    <Button x:Name="BtnCancelResumeWords" Content="取消提取" Click="BtnCancelResumeWords_Click" Margin="10,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Text="使用当前回答模型提取已保存简历中的专业词，简历文本会发送至该服务。自动合并，保留已有词，可编辑后保存。" TextWrapping="Wrap" />
                                <TextBlock x:Name="TxtResumeWordsStatus" Style="{StaticResource HintText}" Margin="0,6,0,6" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource HintText}" Text="每行一个词，例如公司名、人名或技术术语。最多 200 个，每个最多 64 字。留空使用普通识别。" TextWrapping="Wrap" />
                                <TextBox x:Name="TxtHotwords" Height="130" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Hotwords_Changed" />
                                <TextBlock Text="解码增强强度" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Slider x:Name="SldHotwordsScore" Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="HotwordsScore_Changed" />
                                <TextBlock x:Name="TxtHotwordsHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="字幕卡">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="字幕卡外观" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource HintText}" Text="字幕卡默认显示在左下角。字体、字号、透明度和位置保存后立即生效。" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="位置" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CmbOverlayPosition" SelectionChanged="OverlayCombo_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#203A31" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CmbOverlayFont" SelectionChanged="OverlayCombo_Changed" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="答案颜色" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ColorSwatch}" Background="#00F0FF" Tag="#00F0FF" ToolTip="青色" Click="AnswerColorSwatch_Click" />
                                        <Button Style="{StaticResource ColorSwatch}" Background="#F8FAFC" Tag="#F8FAFC" ToolTip="白色" Click="AnswerColorSwatch_Click" />
                                        <Button Style="{StaticResource ColorSwatch}" Background="#FACC15" Tag="#FACC15" ToolTip="黄色" Click="AnswerColorSwatch_Click" />
                                        <Button Style="{StaticResource ColorSwatch}" Background="#34D399" Tag="#34D399" ToolTip="绿色" Click="AnswerColorSwatch_Click" />
                                        <Button Style="{StaticResource ColorSwatch}" Background="#FB7185" Tag="#FB7185" ToolTip="粉色" Click="AnswerColorSwatch_Click" />
                                        <Button Style="{StaticResource ColorSwatch}" Background="#A78BFA" Tag="#A78BFA" ToolTip="紫色" Click="AnswerColorSwatch_Click" />
                                        <TextBox x:Name="TxtAnswerColor" Width="88" Height="28" Padding="6,4" FontFamily="Consolas" Text="#00F0FF" TextChanged="AnswerColor_TextChanged" ToolTip="支持 #RRGGBB 或颜色名，例如 #00F0FF" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <TextBlock Text="答案字号" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="−" Style="{StaticResource StepButton}" Tag="AnswerFontDown" Click="OverlayStep_Click" />
                                                <TextBlock x:Name="TxtAnswerFontSizeValue" Text="15" Foreground="#157D64" FontSize="11" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Content="+" Style="{StaticResource StepButton}" Tag="AnswerFontUp" Click="OverlayStep_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="SldAnswerFontSize" Minimum="12" Maximum="40" Value="15" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" LargeChange="4" ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="问题字号" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="−" Style="{StaticResource StepButton}" Tag="QuestionFontDown" Click="OverlayStep_Click" />
                                                <TextBlock x:Name="TxtQuestionFontSizeValue" Text="13" Foreground="#157D64" FontSize="11" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Content="+" Style="{StaticResource StepButton}" Tag="QuestionFontUp" Click="OverlayStep_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="SldQuestionFontSize" Minimum="10" Maximum="30" Value="13" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" LargeChange="4" ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="背景不透明度" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="−" Style="{StaticResource StepButton}" Tag="BackgroundOpacityDown" Click="OverlayStep_Click" />
                                                <TextBlock x:Name="TxtBackgroundOpacityValue" Text="85%" Foreground="#157D64" FontSize="11" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Content="+" Style="{StaticResource StepButton}" Tag="BackgroundOpacityUp" Click="OverlayStep_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="SldBackgroundOpacity" Minimum="0" Maximum="100" Value="85" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" LargeChange="5" ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="文字不透明度" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="−" Style="{StaticResource StepButton}" Tag="TextOpacityDown" Click="OverlayStep_Click" />
                                                <TextBlock x:Name="TxtTextOpacityValue" Text="92%" Foreground="#157D64" FontSize="11" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Content="+" Style="{StaticResource StepButton}" Tag="TextOpacityUp" Click="OverlayStep_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="SldTextOpacity" Minimum="0" Maximum="100" Value="92" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" LargeChange="5" ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="两项独立调整：0% 完全透明，100% 完全不透明。文字设置同时作用于问题、回答和标题。" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <TextBlock Text="水平边距" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="−" Style="{StaticResource StepButton}" Tag="MarginXDown" Click="OverlayStep_Click" />
                                                <TextBlock x:Name="TxtMarginXValue" Text="24" Foreground="#157D64" FontSize="11" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Content="+" Style="{StaticResource StepButton}" Tag="MarginXUp" Click="OverlayStep_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="SldMarginX" Minimum="0" Maximum="200" Value="24" IsSnapToTickEnabled="True" TickFrequency="2" IsMoveToPointEnabled="True" LargeChange="4" ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="垂直边距" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="−" Style="{StaticResource StepButton}" Tag="MarginYDown" Click="OverlayStep_Click" />
                                                <TextBlock x:Name="TxtMarginYValue" Text="24" Foreground="#157D64" FontSize="11" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Content="+" Style="{StaticResource StepButton}" Tag="MarginYUp" Click="OverlayStep_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="SldMarginY" Minimum="0" Maximum="200" Value="24" IsSnapToTickEnabled="True" TickFrequency="2" IsMoveToPointEnabled="True" LargeChange="4" ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="#F7FAF8" BorderBrush="#E0E9E4" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkAutoHide" Content="一段时间后自动隐藏字幕卡" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="隐藏等待" Foreground="#718179" FontSize="11" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbAutoHideSeconds" Grid.Column="1" Width="120" SelectionChanged="OverlayCombo_Changed">
                                                <ComboBoxItem Content="10 秒" Tag="10" />
                                                <ComboBoxItem Content="20 秒" Tag="20" />
                                                <ComboBoxItem Content="30 秒" Tag="30" />
                                                <ComboBoxItem Content="60 秒" Tag="60" />
                                                <ComboBoxItem Content="120 秒" Tag="120" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="默认关闭。关闭后卡片会一直保留，直到下一次回答替换它。" />
                                    </StackPanel>
                                </Border>
                                <Grid x:Name="PreviewCard" Margin="0,14,0,0">
                                    <Border x:Name="PreviewBackground" Background="#173428" BorderBrush="#405D7E63" BorderThickness="1" CornerRadius="10" />
                                    <StackPanel x:Name="PreviewText" Margin="14">
                                        <TextBlock Text="预览（实际位置按上方选择）" Foreground="#A6C6B5" FontSize="10" Margin="0,0,0,6" />
                                        <TextBlock x:Name="TxtPreviewQuestion" Text="[对方] 让我自我介绍一下" Foreground="#B3CBBF" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtPreviewAnswer" Text="好的，我先简单介绍一下自己负责的工作。" Foreground="#00F0FF" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="自动应答">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="按你的节奏接话" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,12" />
                        <TextBlock Text="对方停顿后，附耳会结合最近对话生成回答建议。" Style="{StaticResource HintText}" Margin="0,0,0,18" />
                        <TextBlock Text="回答失败会持续自动重试，直到成功；可随时点击回答卡上的「停止生成」中止。" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                        <Border Background="White" BorderBrush="#E0E9E4" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,14,0,0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoAnswer" Content="静音后自动生成回答" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="静音等待" Foreground="#718179" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="−" Style="{StaticResource StepButton}" Tag="AutoSilenceDown" Click="OverlayStep_Click" />
                                        <TextBlock x:Name="TxtAutoSilenceValue" Text="2.0 秒" Foreground="#157D64" FontSize="11" MinWidth="46" TextAlignment="Center" VerticalAlignment="Center" />
                                        <Button Content="+" Style="{StaticResource StepButton}" Tag="AutoSilenceUp" Click="OverlayStep_Click" />
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="SldAutoSilence" Minimum="1" Maximum="10" Value="2" IsSnapToTickEnabled="True" TickFrequency="0.5" IsMoveToPointEnabled="True" LargeChange="0.5" ValueChanged="OverlaySlider_Changed" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="音频停顿且识别完成后，结合最近对话生成回答建议。" />
                                <CheckBox x:Name="ChkCorrectQuestion" Content="自动提取并校正问题" Margin="0,20,0,0" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="合并本轮被拆开的句子，整理口语重复，并结合上下文校正明显识别错误。校正后直接回答，原文保留供核对；不确定词会提示。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="设置保存在本机" Style="{StaticResource HintText}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" Click="BtnCancel_Click" Margin="0,0,10,0" MinWidth="84" />
                <Button x:Name="BtnSave" Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" IsDefault="True" MinWidth="120" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
