<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Earcue.App.ProfileWindow" Title="面试资料 · 附耳 Earcue" Width="1000" Height="740" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico" Background="#F3F7F5" Foreground="#203A31" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="让回答，更像你自己" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="告诉附耳你的角色与经历，生成更贴合你的回答建议。" Style="{StaticResource HintText}" Margin="0,7,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceCard}" Padding="22">
                <StackPanel>
                    <TextBlock Text="我的角色" Style="{StaticResource SectionTitle}" />
                    <ComboBox x:Name="CmbRole" SelectionChanged="CmbRole_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="TxtRoleHint" Style="{StaticResource HintText}" Margin="0,12,0,24" />
                    <TextBlock Text="岗位 / 身份补充" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtUserRole" Height="42" TextChanged="TxtUserRole_TextChanged" ToolTip="例如：后端开发 / 5 年经验" />
                    <TextBlock Text="例如：后端开发，5 年经验" Style="{StaticResource HintText}" Margin="0,9,0,22" />
                    <Border Background="#EDF6EF" CornerRadius="10" Padding="14">
                        <TextBlock Text="资料保存在本机。生成回答时，将随对话发送给你选择的模型。" Foreground="#5F816A" TextWrapping="Wrap" FontSize="11" LineHeight="20" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="个人简历与背景" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtResumeCount" HorizontalAlignment="Right" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="TxtResumeLabel" Grid.Row="1" Text="个人简历（用于回答时引用真实经历）" Style="{StaticResource HintText}" Margin="0,0,0,14" />
                    <Grid Grid.Row="2">
                        <TextBox x:Name="TxtResume" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Padding="14" FontSize="13" TextChanged="TxtResume_TextChanged" SpellCheck.IsEnabled="False" />
                        <TextBlock Text="粘贴你的简历、项目经历或岗位要求…" Foreground="#98AA9D" Margin="16,16,16,0" VerticalAlignment="Top" TextWrapping="Wrap" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtResume}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="支持 TXT / Markdown / Word" Style="{StaticResource HintText}" FontSize="10" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnImportResume" Content="导入文件" Style="{StaticResource LinkButton}" Click="BtnImportResume_Click" FontSize="11" />
                            <Button x:Name="BtnClearResume" Content="清空" Style="{StaticResource LinkButton}" Click="BtnClearResume_Click" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="保存后立即用于后续回答" Style="{StaticResource HintText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Click="BtnCancel_Click" Margin="0,0,10,0" MinWidth="84" />
                <Button x:Name="BtnSave" Content="保存资料" IsDefault="True" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" MinWidth="110" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
